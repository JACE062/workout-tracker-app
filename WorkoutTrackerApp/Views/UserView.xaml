<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WorkoutTrackerApp.ViewModels"
             xmlns:models="clr-namespace:WorkoutTracker.Data;assembly=WorkoutTracker.Data"
             x:Class="WorkoutTrackerApp.Views.UserView"
             x:DataType="viewmodels:UserViewModel"
             Title="User Login">
    <VerticalStackLayout>
        <Label 
            Text="Please Log In or Register to continue to the Workout Tracker App"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            HorizontalTextAlignment="Center"
            FontSize="28"
            WidthRequest="480"
            Margin="0, 50, 0, 30"/> 
        
        <Button 
            Text="Login"
            Command="{Binding LoginRedirectCommand}"
            WidthRequest="300"
            HorizontalOptions="Center" 
            Margin="0, 35"/>
        <Button
            Text="Register User"
            Command="{Binding RegisterUserCommand}"
            WidthRequest="300"
            HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>