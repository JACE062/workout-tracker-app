<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkoutTrackerApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Welcome to the Workout Tracker App!"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
            <Label
                Text="This application helps you track your workouts, set goals, and monitor your progress over time. Whether you're a beginner or an experienced athlete, the Workout Tracker App is designed to support you on your fitness journey."
                WidthRequest="600"
                SemanticProperties.HeadingLevel="Level2" />

            <Label
                Text="Let's get started!"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2" />
            
            <Button
                Text="Login"
                FontSize="18"
                SemanticProperties.Hint="Navigate to the User Login and Registration page."
                WidthRequest="100"
                HorizontalOptions="Center" 
                Margin="0, 35"
                Clicked="OnUserButtonClicked" />
            

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
